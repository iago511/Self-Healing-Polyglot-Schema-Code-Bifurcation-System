# Configuração local
PROJECT_PATH=
DB_URL=postgresql://usuario:senha@127.0.0.1:5432/banco
PG_SCHEMA=public
PROJECT_ID=
BANCO_ID=
WATCH_INTERVAL_SECONDS=5
# As propostas e o SQLite ficam fora do projeto monitorado.
EVENTOS_DB_PATH=
PROPOSTAS_DIR=

# Modelos
GROQ_API_KEY=
GROQ_MODELO_ESPECIALISTA=openai/gpt-oss-120b
GROQ_MODELO_RAPIDO=openai/gpt-oss-20b
OLLAMA_MODELO=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Validação das propostas
IMAGEM_TESTE=
TEST_TIMEOUT_SECONDS=120
MAX_TENTATIVAS=2
DOCKER_TEST_STORAGE=bind

# Compose. Use host.docker.internal nas URLs dos serviços que rodam no host.
TARGET_PROJECT_PATH=
TARGET_PROJECT_READ_ONLY=true
DOCKER_SOCKET_GID=0
