# Local configuration
PROJECT_PATH=
DB_URL=postgresql://user:password@127.0.0.1:5432/database
PG_SCHEMA=public
PROJECT_ID=
BANCO_ID=
WATCH_INTERVAL_SECONDS=5
# Keep proposals and the SQLite database outside the monitored project.
EVENTOS_DB_PATH=
PROPOSTAS_DIR=

# Models
GROQ_API_KEY=
GROQ_MODELO_ESPECIALISTA=openai/gpt-oss-120b
GROQ_MODELO_RAPIDO=openai/gpt-oss-20b
OLLAMA_MODELO=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300

# Proposal validation
IMAGEM_TESTE=
TEST_TIMEOUT_SECONDS=120
MAX_TENTATIVAS=2
DOCKER_TEST_STORAGE=bind

# Compose. Use host.docker.internal in URLs for services running on the host.
TARGET_PROJECT_PATH=
TARGET_PROJECT_READ_ONLY=true
DOCKER_SOCKET_GID=0
